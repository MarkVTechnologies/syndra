# ── Core ──────────────────────────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_SECRET=                      # openssl rand -base64 32
ENCRYPTION_KEY=                   # 32-byte hex: openssl rand -hex 32
ATTRIBUTION_SECRET=               # openssl rand -base64 32

# ── Data ──────────────────────────────────────────────────────────────────
# Must be a replica set — transactions require it (Atlas clusters always are;
# a standalone mongod is not). Atlas → Network Access must allow your
# machine's IP (or 0.0.0.0/0 for local dev) or every query hangs until
# serverSelectionTimeoutMS.
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net
MONGODB_DB=san_development
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Jobs & email ──────────────────────────────────────────────────────────
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM="SAN <noreply@mail.san.com>"
EMAIL_REPLY_TO=support@san.com

# ── Media ─────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# ── Payments (Day 4) ─────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=

# ── Security & observability ────────────────────────────────────────────
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Rotate immediately after first login (PRD §15.1)
ADMIN_SEED_EMAIL=admin@san.com
ADMIN_SEED_PASSWORD=change-me-now-1234
